# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
venv/
env/
.venv/
.env/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Build artifacts
/build/
/dist/
*.spec

# PyInstaller
*.manifest

# Installer outputs
installer/Output/
installer/tmp/

# Logs
*.log
logs/

# Temp files
tmp/
temp/
*.tmp

# Tessdata binary files (too large for repo)
resources/tessdata/*.traineddata
resources/tessdata/*.bin

# Tesseract binary (bundled at build time)
resources/tesseract/*
!resources/tesseract/.gitkeep

# GOT-OCR 2.0 model weights + trust_remote_code scripts. Downloaded
# to ``resources/models/got_ocr2/`` by ``.github/scripts/download_got_ocr2.py``
# in the CI installer workflow and by the in-app "Download GOT-OCR 2.0"
# action at runtime. Too big for git (~1.4 GB for model.safetensors
# alone). The manifest + download script is the single source of truth;
# regeneration is a one-command operation.
resources/models/

# Generated Windows icon
resources/icons/app.ico

# Test outputs
tests/test_data/*_ocr.pdf
tests/test_data/output/

# Local OCR input samples — per-developer test docs, not shipped
inputs/

# Benchmark outputs — ``scripts/benchmark_universal.py`` writes its
# searchable PDF next to the input by default (``<pdf>.ocr.pdf``).
# These are throwaway artefacts of a measurement run, not fixtures,
# so keep them out of git regardless of which folder the input sits in.
*.ocr.pdf
inputs/*.ocr.pdf

# Generated test fixtures — produced by tests/fixtures/generate_fixtures.py
# and tests/fixtures/accuracy_corpus/generate.py on first test run, not
# committed (300+ MB of synthetic PDFs total). The generators are
# deterministic so any contributor can reproduce them.
tests/fixtures/*.pdf
tests/fixtures/nightly/
tests/fixtures/accuracy_corpus/*.pdf
tests/fixtures/accuracy_corpus/*.txt

# OS
Thumbs.db
desktop.ini
