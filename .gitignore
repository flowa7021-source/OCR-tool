__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
venv/
env/
.venv/
.env/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Build artifacts
/build/
/dist/
*.spec

# PyInstaller
*.manifest

# Installer outputs
installer/Output/
installer/tmp/

# Logs
*.log
logs/

# Temp files
tmp/
temp/
*.tmp

# EasyOCR model weights — downloaded by scripts/prefetch_easyocr_models.py
# before ``python build.py`` runs. Too large for git (~100 MB total); the
# prefetch step is a single command and the CI installer workflow does it
# automatically before PyInstaller packaging.
resources/easyocr_models/*.pth

# Generated Windows icon
resources/icons/app.ico

# Test outputs
tests/test_data/*_ocr.pdf
tests/test_data/output/

# Local OCR input samples — per-developer test docs, not shipped
inputs/

# Benchmark outputs — ``scripts/benchmark_universal.py`` writes its
# searchable PDF next to the input by default (``<pdf>.ocr.pdf``).
# These are throwaway artefacts of a measurement run, not fixtures,
# so keep them out of git regardless of which folder the input sits in.
*.ocr.pdf
inputs/*.ocr.pdf

# Generated test fixtures — produced by tests/fixtures/generate_fixtures.py
# and tests/fixtures/accuracy_corpus/generate.py on first test run, not
# committed (300+ MB of synthetic PDFs total). The generators are
# deterministic so any contributor can reproduce them.
tests/fixtures/*.pdf
tests/fixtures/nightly/
tests/fixtures/accuracy_corpus/*.pdf
tests/fixtures/accuracy_corpus/*.txt

# Fine-tune training crops — produced by
# scripts/finetune/bootstrap_dataset.py from inputs/*.pdf + inputs/*.txt.
# Typically 1-2 GB of crop jpegs. Regenerate locally with the bootstrap
# script; upload to Colab/Kaggle Drive for actual GPU training.
datasets/

# EasyOCR trainer clone — created on first invocation of
# scripts/finetune/finetune_recognizer.py; ~20 MB checkout. Regenerated
# on demand, not versioned with our repo.
.finetune_trainer/

# OS
Thumbs.db
desktop.ini
