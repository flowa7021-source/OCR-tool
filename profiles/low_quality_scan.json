{
  "name": "low_quality_scan",
  "description": "Агрессивная обработка для плохо отсканированных документов",
  "schema_version": 4,
  "preprocess": {
    "auto_rotate": {
      "enabled": true,
      "min_confidence": 1.0
    },
    "deskew": {
      "enabled": true,
      "auto_detect": true,
      "manual_angle": 0.0,
      "max_angle": 45.0
    },
    "dewarp": {
      "enabled": false,
      "text_min_width": 15,
      "text_min_height": 2,
      "text_min_aspect": 1.5,
      "focal_length": 1.2
    },
    "binarization": {
      "method": "adaptive_gaussian",
      "adaptive_block_size": 31,
      "adaptive_c": 10,
      "sauvola_window": 25,
      "sauvola_k": 0.2
    },
    "denoise": {
      "enabled": true,
      "steps": [
        {
          "method": "nlm",
          "enabled": true,
          "ksize": 3,
          "sigma": 1.0,
          "h": 15,
          "morph_ksize": 3
        },
        {
          "method": "median",
          "enabled": true,
          "ksize": 5,
          "sigma": 1.0,
          "h": 7,
          "morph_ksize": 3
        }
      ]
    },
    "contrast": {
      "clahe_enabled": true,
      "clahe_clip": 4.0,
      "clahe_tile": 8,
      "manual_enabled": false,
      "alpha": 1.0,
      "beta": 0
    },
    "background": {
      "enabled": true,
      "blur_kernel": 55
    }
  },
  "ocr": {
    "engine": "tesseract",
    "languages": [
      "rus",
      "eng"
    ],
    "primary_language": "rus",
    "psm": 3,
    "oem": 1,
    "dpi": 400,
    "char_whitelist": "",
    "char_blacklist": "",
    "confidence_threshold": 60.0,
    "tesseract_timeout": 300,
    "optimize_level": 1,
    "skip_text": true,
    "max_pages": 0,
    "extra_tesseract_params": {
      "preserve_interword_spaces": "1",
      "tessedit_do_invert": "0"
    }
  },
  "postprocess": {
    "autocorrect_russian": true,
    "autocorrect_english": true,
    "merge_hyphenated": true,
    "normalize_whitespace": true,
    "normalize_unicode": true,
    "remove_artifacts": true,
    "fix_cyrillic_latin_confusion": true,
    "custom_rules": []
  },
  "builtin": true,
  "created_at": "2026-04-14T10:41:19.005260"
}
