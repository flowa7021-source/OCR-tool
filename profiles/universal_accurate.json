{
  "name": "universal_accurate",
  "description": "Универсальный default (апрель 2026): минимальная предобработка после benchmark'а на реальных ТН. OTSU binarization + deskew, БЕЗ CLAHE / denoise / border-removal / background-removal — aggressive препроцессинг выжигал мелкий шрифт в ячейках таблиц и давал завышенный OCR-conf (88%) при низкой parser-accuracy (34%). Clean-path даёт чуть ниже OCR-conf (74%) но почти вдвое выше parser-accuracy (64%) за счёт сохранения тонких штрихов. 300 DPI (sweet-spot для LSTM). Полный postprocess + fuzzy_correction_ru + pymorphy3-validated dictionary. extract.kind=tn_upd — встроенный парсер с multi-document + layout-aware + batch-learning.",
  "schema_version": 12,
  "preprocess": {
    "auto_rotate": {
      "enabled": true,
      "min_confidence": 1.0
    },
    "deskew": {
      "enabled": true,
      "auto_detect": true,
      "manual_angle": 0.0,
      "max_angle": 45.0
    },
    "dewarp": {
      "enabled": false,
      "text_min_width": 15,
      "text_min_height": 2,
      "text_min_aspect": 1.5,
      "focal_length": 1.2
    },
    "binarization": {
      "method": "otsu",
      "adaptive_block_size": 31,
      "adaptive_c": 10,
      "sauvola_window": 51,
      "sauvola_k": 0.34
    },
    "denoise": {
      "enabled": false,
      "steps": []
    },
    "contrast": {
      "clahe_enabled": false,
      "clahe_clip": 1.5,
      "clahe_tile": 8,
      "manual_enabled": false,
      "alpha": 1.0,
      "beta": 0
    },
    "background": {
      "enabled": false,
      "blur_kernel": 55
    },
    "border_removal": {
      "enabled": false,
      "min_line_length": 150
    }
  },
  "ocr": {
    "engine": "tesseract",
    "languages": [
      "rus",
      "eng"
    ],
    "primary_language": "rus",
    "psm": 3,
    "oem": 1,
    "dpi": 300,
    "char_whitelist": "",
    "char_blacklist": "",
    "confidence_threshold": 60.0,
    "tesseract_timeout": 360,
    "optimize_level": 1,
    "skip_text": true,
    "max_pages": 0,
    "use_user_dictionaries": true,
    "drop_low_conf_words": true,
    "soft_rescue_dropped_words": true,
    "redact_noisy_blocks": false,
    "adaptive_confidence_threshold": true,
    "per_word_script_disambiguation": true,
    "per_word_clahe_rescue": true,
    "per_word_upscale_rescue": true,
    "user_words_fuzzy_rescue": true,
    "per_block_psm_retry": true,
    "extra_tesseract_params": {
      "preserve_interword_spaces": "1",
      "tessedit_do_invert": "0",
      "load_freq_dawg": "0"
    }
  },
  "postprocess": {
    "autocorrect_russian": true,
    "autocorrect_english": true,
    "merge_hyphenated": true,
    "normalize_whitespace": true,
    "normalize_unicode": true,
    "remove_artifacts": true,
    "fix_cyrillic_latin_confusion": true,
    "garbage_filter_strictness": "lenient",
    "mark_suspect_handwritten_blocks": true,
    "validate_identifiers": true,
    "validate_entities": true,
    "fuzzy_correction_ru": true,
    "custom_rules": []
  },
  "extract": {
    "enabled": true,
    "kind": "tn_upd",
    "multi_document": true,
    "low_text_threshold": 200,
    "cache_enabled": true,
    "org_lookup": true,
    "llm_fallback": {
      "enabled": false,
      "min_confidence": 0.4,
      "model": "claude-opus-4-7",
      "max_text_chars": 20000
    }
  },
  "builtin": true,
  "created_at": "2026-04-21T05:57:02.275527+00:00"
